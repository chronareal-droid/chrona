{
  "name": "shorts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render:day1": "remotion render Day1 out/day1.mp4",
    "cover:day1": "remotion still Day1 out/day1-cover.png --frame=0",
    "stills": "node scripts/stills.mjs",
    "contact-sheet": "python3 scripts/contact-sheet.py",
    "setup:tts": "bash scripts/setup-tts.sh",
    "voice:day1": ".tts/venv/bin/python scripts/voiceover.py voice/day1.json",
    "music:day1": "python3 scripts/music.py --plan day1 --out public/music.mp3",
    "voice:day1-male": ".tts/venv/bin/python scripts/voiceover.py voice/day1.json --voice am_michael --output public/voice-am_michael.mp3 --timings src/videos/day1.voice.am_michael.json",
    "render:day1-male": "remotion render Day1MaleVoice out/day1-male-voice.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.530",
    "@remotion/google-fonts": "^4.0.530",
    "@remotion/layout-utils": "^4.0.530",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.530"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "typescript": "^5.9.2"
  }
}
