{
  "name": "unflagged",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:functions": "cd supabase/functions && deno test --allow-env",
    "check:functions": "cd supabase/functions && deno check */index.ts _shared/*.ts",
    "test:db": "node supabase/tests/migrations.test.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "deploy:pages": "npm run check:launch && npm run build && npx wrangler pages deploy dist --project-name unflagged",
    "build:demo": "tsc -b && vite build --config vite.demo.config.ts && node scripts/demo-page.mjs",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "posthog-js": "^1.266.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
