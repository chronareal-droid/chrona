# Used by `npm run build:e2e`: the e2e suite intercepts every call to these hosts (see e2e/mock.ts).
# PostHog is on (with a fake key) so the suite can check what analytics would receive.
VITE_SUPABASE_URL=https://mock.supabase.test
VITE_SUPABASE_ANON_KEY=e2e-anon-key
VITE_POSTHOG_KEY=phc_e2e_fake_key
